---
import type { SiteContent } from '../data/i18n/types';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { ui, brand, languages, nav } = content;
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href={brand.homeHref}>
      <span class="mark" aria-hidden="true">{brand.mark}</span>
      <span class="brand-name" lang={brand.nameLang}>{brand.name}</span>
    </a>
    <div class="header-tools">
      <nav class="lang-switch" aria-label={ui.langLabel}>
        {
          languages.map((language) => (
            <a
              href={language.href}
              hreflang={language.lang}
              lang={language.lang}
              data-keep-hash
              aria-current={language.lang === content.locale ? 'page' : undefined}
            >
              {language.label}
              {language.lang === content.locale && <span class="sr-only"> ({ui.currentPage})</span>}
            </a>
          ))
        }
      </nav>
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        data-to-dark={ui.themeToDark}
        data-to-light={ui.themeToLight}
        aria-label={ui.themeToDark}
        aria-pressed="false"
      >
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="wrap">
    <nav class="section-nav" aria-label={ui.navLabel}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
